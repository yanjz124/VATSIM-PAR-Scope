<ui:FluentWindow x:Class="PARScope.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
                 xmlns:vm="clr-namespace:PARScope.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="PAR Scope"
                 Width="1440" Height="900" MinWidth="980" MinHeight="620"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="PAR Scope" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/PARScope.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Command bar -->
        <Border Grid.Row="1" Padding="12,4,12,10">
            <DockPanel LastChildFill="False">
                <!-- Airport search -->
                <Grid DockPanel.Dock="Left" Width="230" Margin="0,0,8,0">
                    <ui:TextBox x:Name="AirportBox" PlaceholderText="Airport (KNKX, NKX, EGQS…)"
                                Text="{Binding AirportQuery, UpdateSourceTrigger=PropertyChanged}"
                                Icon="{ui:SymbolIcon Search24}"
                                KeyDown="AirportBox_KeyDown" LostKeyboardFocus="AirportBox_LostFocus" />
                    <Popup x:Name="AirportPopup" PlacementTarget="{Binding ElementName=AirportBox}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" Width="380">
                        <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="6" Padding="4"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <ListBox x:Name="AirportList" ItemsSource="{Binding AirportResults}" MaxHeight="360"
                                     MouseLeftButtonUp="AirportList_Pick" KeyDown="AirportList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Id}" Width="54" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Icao}" Width="48"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <ComboBox IsSynchronizedWithCurrentItem="False" DockPanel.Dock="Left" Width="92" Margin="0,0,8,0" ToolTip="Runway"
                          ItemsSource="{Binding Runways}" SelectedItem="{Binding SelectedRunway}" DisplayMemberPath="RunwayId" />

                <ComboBox IsSynchronizedWithCurrentItem="False" DockPanel.Dock="Left" Width="210" Margin="0,0,12,0" ToolTip="Radar model"
                          ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ListBox DockPanel.Dock="Left" Style="{StaticResource SegmentedList}" Margin="0,0,12,0" VerticalAlignment="Center"
                         ItemsSource="{Binding RangeScales}" SelectedItem="{Binding RangeScaleItem}" ToolTip="Range scale (PgUp / PgDn)">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource RangeLabel}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ToolbarToggle}" Content="MTI" IsChecked="{Binding Mti}"
                                  ToolTip="Moving target indicator: rejects targets slower than 40 kt and most ground clutter" />
                    <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Safety" IsChecked="{Binding ShowSafetyLimits}" ToolTip="Lower safe limit (TERPS obstacle clearance surface)" />
                    <ToggleButton Style="{StaticResource ToolbarToggle}" Content="2°/5°" IsChecked="{Binding ShowCourseWedge}" ToolTip="UK RA 3291 azimuth lines from touchdown (not shown on US displays)" />
                    <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Scan" IsChecked="{Binding ShowScan}"
                                  ToolTip="Antenna sweep trace. Defaults per radar model (on for analog indicators); click to override." />
                    <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Log" IsChecked="{Binding LogRange}" ToolTip="Compressed (logarithmic) range axis" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Training" IsChecked="{Binding TrainingMode}" Margin="0,0,8,0"
                                  ToolTip="Training mode: training traffic, simulated pilot/tower radio, suggested calls. Off = plain VATSIM scope." />
                    <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding TrainingPaused}" Margin="0,0,8,0"
                                  Visibility="{Binding TrainingMode, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Pause / resume training traffic (P). Network traffic keeps moving.">
                        <ui:SymbolIcon Symbol="Pause24" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding ShowPlanView}" ToolTip="Show side panel">
                        <ui:SymbolIcon Symbol="PanelRight24" />
                    </ToggleButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Scopes and side panel -->
        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SideColumn" Width="380" MinWidth="0" MaxWidth="900" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Background="{StaticResource ScopeBackgroundBrush}" ClipToBounds="True"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <skia:SKElement x:Name="ParView" PaintSurface="ParView_PaintSurface" MouseLeftButtonDown="ParView_MouseDown" Cursor="Cross" />
            </Border>

            <!-- Drag to resize the side panel; the ASR view stays square and grows with it. -->
            <GridSplitter x:Name="SideSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                          Cursor="SizeWE" ResizeBehavior="PreviousAndNext" DragCompleted="SideSplitter_DragCompleted" />

            <ScrollViewer Grid.Column="2" Margin="2,0,0,0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowPlanView, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>

                    <!-- Every section collapses; open/closed state is remembered. -->
                    <ui:CardExpander Header="Selected target" Icon="{ui:SymbolIcon Target24}" Margin="0,0,0,6" IsExpanded="{Binding ExpandTarget}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedHeader}" FontSize="18" FontWeight="SemiBold" />
                            </DockPanel>
                            <TextBlock Text="{Binding SelectedSub}" Style="{StaticResource MetricLabel}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />

                            <UniformGrid Columns="2" Rows="2">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Range from touchdown" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource MetricValue}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Glidepath" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding GlidepathText}" Style="{StaticResource MetricValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Course" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding CourseText}" Style="{StaticResource MetricValue}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding TrainingMode, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Recommended descent" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding RodText}" Style="{StaticResource MetricValue}" />
                                </StackPanel>
                            </UniformGrid>

                            <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="6" Height="104"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Visibility="{Binding SuggestionsVisible, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="16" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="SUGGESTED CALL" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                                    <TextBlock Grid.Row="1" Text="{Binding AdvisoryText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               FontSize="12.5" />
                                    <TextBlock Grid.Row="2" Text="{Binding RangeCallText}" FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Header="ASR" Icon="{ui:SymbolIcon GridCircles24}" Margin="0,0,0,6" IsExpanded="{Binding ExpandAsr}">
                        <Grid>
                            <Border x:Name="PlanHost" Height="360" CornerRadius="6" ClipToBounds="True" Background="{StaticResource ScopeBackgroundBrush}"
                                    SizeChanged="PlanHost_SizeChanged">
                                <skia:SKElement x:Name="PlanView" PaintSurface="PlanView_PaintSurface" MouseLeftButtonDown="PlanView_MouseDown" Cursor="Cross" />
                            </Border>
                            <ComboBox IsSynchronizedWithCurrentItem="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Width="90"
                                      ItemsSource="{Binding PlanRanges}" SelectedItem="{Binding PlanRangeNm}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource RangeLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </ui:CardExpander>

                    <ui:CardExpander Icon="{ui:SymbolIcon WeatherPartlyCloudyDay24}" Margin="0,0,0,6" IsExpanded="{Binding ExpandWeather}">
                        <ui:CardExpander.Header>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Weather" VerticalAlignment="Center" />
                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                        Background="{Binding MetarCategory, Converter={StaticResource StatusBrush}}">
                                    <TextBlock Text="{Binding MetarCategory, Converter={StaticResource CategoryLabel}}" FontSize="11" FontWeight="Bold" Foreground="#05080B" />
                                </Border>
                            </DockPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding MetarSpoken}" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MetarRaw}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,8" />
                            <ui:ToggleSwitch IsChecked="{Binding UseVatsimMetar}" OnContent="VATSIM METAR" OffContent="NOAA METAR" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Training radio: push-to-talk or typed transmissions, simulated pilot and tower. -->
                    <ui:CardExpander Header="Radio (training)" Icon="{ui:SymbolIcon Mic24}" Margin="0,0,0,6" IsExpanded="{Binding ExpandVoice}"
                                     Visibility="{Binding ShowRadio, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Mic24" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding VoiceState}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <ui:TextBox x:Name="TypedBox" PlaceholderText="…or type: turn left heading 240, slightly above glidepath"
                                        Text="{Binding TypedTransmission, UpdateSourceTrigger=PropertyChanged}" KeyDown="TypedBox_KeyDown" />

                            <!-- Fixed-height log so the panel never resizes. -->
                            <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="6" Height="112"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <ItemsControl ItemsSource="{Binding RadioLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" Height="16" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Height="18">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{Binding TxTimerLevel, Converter={StaticResource StatusBrush}}" />
                                <TextBlock Text="{Binding TxTimerText}" FontSize="11.5" VerticalAlignment="Center"
                                           ToolTip="PAR transmissions are due about every 5 seconds (7110.65 §5-12-4); lost communications after 5 seconds on final (§5-10-4)." />
                            </StackPanel>
                            <TextBlock Text="PILOT" Style="{StaticResource SectionLabel}" Margin="0,8,0,2" />
                            <TextBlock Text="{Binding PilotStatus}" FontSize="12" TextTrimming="CharacterEllipsis" Height="18" />

                            <TextBlock Text="TOWER" Style="{StaticResource SectionLabel}" Margin="0,8,0,4" />
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Request" Margin="6,0,0,0" Command="{Binding RequestTowerCommand}"
                                           ToolTip="Interphone request to tower for the selected aircraft; relay the clearance with wind (7110.65 §5-10-13)" />
                                <ComboBox IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding TowerIntents}" SelectedItem="{Binding TowerIntent}" />
                            </DockPanel>

                            <ui:ToggleSwitch IsChecked="{Binding PilotVoices}" OnContent="Pilot and tower voices" OffContent="Pilot and tower voices" Margin="0,10,0,0" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource MetricLabel}" TextWrapping="Wrap"
                                       Text="Space talk · ←/→ heading ±1° (Shift ±5°) · D begin descent · Q/W/E slightly/–/well above · A on glidepath · Z/X/C slightly/–/well below · G wheels · M missed approach · T tower · P pause · Tab next target" />
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Header="Audio (training)" Icon="{ui:SymbolIcon Speaker224}" Margin="0,0,0,6" IsExpanded="{Binding ExpandAudio}"
                                     Visibility="{Binding TrainingMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Microphone" Style="{StaticResource MetricLabel}" />
                            <ComboBox IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" Margin="0,2,0,4" />
                            <ProgressBar Value="{Binding MicLevel}" Maximum="1" Height="4" Margin="0,0,0,8" ToolTip="Input level while transmitting" />
                            <TextBlock Text="Pilot and tower audio output" Style="{StaticResource MetricLabel}" />
                            <ComboBox IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker}" Margin="0,2,0,8" />
                            <TextBlock Text="Speech recognition" Style="{StaticResource MetricLabel}" />
                            <ComboBox IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding Recognizers}" SelectedItem="{Binding SelectedRecognizer}" Margin="0,2,0,2"
                                      ToolTip="Windows Speech: offline, standard phraseology only. Whisper: local OpenAI model, more tolerant of accents and wording; downloaded on first use." />
                            <TextBlock Text="{Binding VoiceState}" Style="{StaticResource MetricLabel}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Pilot voice" Style="{StaticResource MetricLabel}" />
                                    <ComboBox IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding VoiceNames}" SelectedItem="{Binding PilotVoiceName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tower voice" Style="{StaticResource MetricLabel}" />
                                    <ComboBox IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding VoiceNames}" SelectedItem="{Binding TowerVoiceName}" />
                                </StackPanel>
                            </Grid>
                            <ui:Button Content="Test voices" Icon="{ui:SymbolIcon Speaker224}" Command="{Binding TestVoicesCommand}" />
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Header="Training traffic" Icon="{ui:SymbolIcon Airplane24}" Margin="0,0,0,6" IsExpanded="{Binding ExpandTraining}"
                                     Visibility="{Binding TrainingMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MetricLabel}" Margin="0,0,0,10"
                                       Text="Simulated arrivals for practising talk-downs. Controller-directed pilots hold heading and altitude until you talk to them: hold Space and speak (or type) headings, 'begin descent' and glidepath calls." />
                            <ui:ToggleSwitch IsChecked="{Binding SpawnSelfFlying}" OnContent="Pilot flies the approach" OffContent="Controller-directed" Margin="0,0,0,8" />
                            <ui:ToggleSwitch IsChecked="{Binding ShowAdvisories}" OnContent="Suggested calls for training traffic" OffContent="Suggested calls for training traffic" Margin="0,0,0,6" />
                            <ui:ToggleSwitch IsChecked="{Binding ShowAdvisoriesOnNetwork}" OnContent="Suggested calls for VATSIM traffic" OffContent="Suggested calls for VATSIM traffic" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox PlaceholderText="Callsign (blank = random)" Text="{Binding SpawnCallsign, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:TextBox Grid.Column="2" PlaceholderText="ICAO type (e.g. C30J)" Text="{Binding SpawnType, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Approach speed comes from the FAA Aircraft Characteristics Database for the type." />
                            </Grid>
                            <WrapPanel>
                                <ui:Button Content="Spawn arrival" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Margin="0,0,6,6" Command="{Binding SpawnTrainingCommand}" />
                                <ToggleButton Content="Pause (P)" IsChecked="{Binding TrainingPaused}" Margin="0,0,6,6" Padding="10,5" />
                                <ui:Button Content="Clear" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,6,6" Command="{Binding ClearTrainingCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Header="Setup" Icon="{ui:SymbolIcon Settings24}" Margin="0,0,0,6" IsExpanded="{Binding ExpandSetup}">
                        <StackPanel>
                            <TextBlock Text="{Binding RunwayDetail}" TextWrapping="Wrap" Style="{StaticResource MetricLabel}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Glidepath ° (approach plate)" Style="{StaticResource MetricLabel}" />
                                    <ui:NumberBox Value="{Binding SiteGlidepath}" SmallChange="0.1" MaxDecimalPlaces="2" Minimum="2" Maximum="6" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="TCH ft (approach plate)" Style="{StaticResource MetricLabel}" />
                                    <ui:NumberBox Value="{Binding SiteTch}" SmallChange="1" MaxDecimalPlaces="0" Minimum="20" Maximum="100" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Decision height ft (HAT)" Style="{StaticResource MetricLabel}" />
                                    <ui:NumberBox Value="{Binding SiteDh}" SmallChange="10" MaxDecimalPlaces="0" Minimum="100" Maximum="1000" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="Antenna setback ft" Style="{StaticResource MetricLabel}" ToolTip="Distance past touchdown along the runway" />
                                    <ui:NumberBox Value="{Binding SiteSetback}" SmallChange="100" MaxDecimalPlaces="0" Minimum="0" Maximum="10000" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Antenna offset ft (+ right)" Style="{StaticResource MetricLabel}" />
                                    <ui:NumberBox Value="{Binding SiteOffset}" SmallChange="50" MaxDecimalPlaces="0" Minimum="-2500" Maximum="2500" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="Antenna aim ° toward centreline" Style="{StaticResource MetricLabel}"
                                               ToolTip="ICAO Annex 10 siting example: 15°/5° asymmetric scan, i.e. the sector turned 5° toward the runway centreline." />
                                    <ui:NumberBox Value="{Binding SiteAim}" SmallChange="0.5" MaxDecimalPlaces="1" Minimum="0" Maximum="15" />
                                </StackPanel>
                            </Grid>
                            <ui:ToggleSwitch IsChecked="{Binding UseDataFeed}" Margin="0,0,0,8"
                                             OnContent="Use VATSIM data feed without vPilot" OffContent="Use VATSIM data feed without vPilot"
                                             ToolTip="When no vPilot plugin is connected, show traffic from the public VATSIM data feed (updates every ~15 s). Off by default." />
                            <ui:ToggleSwitch IsChecked="{Binding SimulateErrors}" Margin="0,0,0,8"
                                             OnContent="Simulate radar errors" OffContent="Simulate radar errors"
                                             ToolTip="Measurement noise (ICAO accuracy budget), multipath, ground clutter and missed paints. Off: targets plot exactly where the aircraft is, once per scan." />
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Scope font" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding ScopeFonts}" SelectedItem="{Binding ScopeFont}" />
                            </DockPanel>
                            <ui:ToggleSwitch IsChecked="{Binding UseUkBands}" Margin="0,0,0,10"
                                             OnContent="Deviation terms: UK RA 3291 (feet)" OffContent="Deviation terms: US Navy (target quarters)"
                                             ToolTip="US Navy: slightly/well read from quarters of the radar target (NAVEDTRA 14342A Table 10-1). UK: fixed 60/100 ft and 2°/5° lines." />
                            <WrapPanel>
                                <ui:Button Content="Apply" Appearance="Primary" Margin="0,0,6,0" Command="{Binding ApplySiteCommand}" />
                                <ui:Button Content="Reset to defaults" Command="{Binding ResetSiteCommand}" />
                            </WrapPanel>

                            <Separator Margin="0,14,0,10" />
                            <TextBlock Text="AIRPORT DATA" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding AirportDbStatus}" TextWrapping="Wrap" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <ui:Button Content="Update online" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,6,0"
                                           Command="{Binding UpdateAirportsCommand}" IsEnabled="{Binding IsUpdatingAirports, Converter={StaticResource InverseBool}}" />
                                <ui:Button Content="Import NASR zip…" Icon="{ui:SymbolIcon FolderOpen24}" Click="ImportNasr_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:CardExpander>
                    <ui:CardExpander Header="Diagnostics" Icon="{ui:SymbolIcon Pulse24}" Margin="0,0,0,6" IsExpanded="{Binding ExpandDiagnostics}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabel}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Live update rates per aircraft: fast = VATSIM Velocity positions (up to 5 Hz), slow = 5-second updates or the 15-second data feed." />
                            <Border Padding="8,6" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" MinHeight="60">
                                <ItemsControl ItemsSource="{Binding RateLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <ui:ToggleSwitch IsChecked="{Binding RecordTraffic}" Margin="0,10,0,6"
                                             OnContent="Record traffic log (CSV)" OffContent="Record traffic log (CSV)" />
                            <TextBlock Text="{Binding DiagnosticsFolder}" Style="{StaticResource MetricLabel}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ui:Button Content="Open diagnostics folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenDiagnosticsCommand}" />
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="14,7" Margin="0,8,0,0" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding UtcText}" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding TrafficText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="16,0,0,0" />
                <StackPanel Orientation="Horizontal" ToolTip="{Binding LinkDetail}">
                    <Ellipse Width="9" Height="9" Fill="{Binding Link, Converter={StaticResource StatusBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LinkText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RunwayTitle}" Margin="16,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="640"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
