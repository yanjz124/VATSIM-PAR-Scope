<ui:FluentWindow x:Class="PARScope.App.Views.AsrWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
                 xmlns:vm="clr-namespace:PARScope.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="ASR" Width="720" Height="760" MinWidth="320" MinHeight="340"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="ASR" Height="32" ShowMinimize="False" />
        <Border Grid.Row="1" Margin="8,0,8,8" CornerRadius="8" ClipToBounds="True" Background="{StaticResource ScopeBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <skia:SKElement x:Name="PlanView" PaintSurface="PlanView_PaintSurface" MouseLeftButtonDown="PlanView_MouseDown" Cursor="Cross" />
                <ComboBox IsSynchronizedWithCurrentItem="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Width="90"
                          ItemsSource="{Binding PlanRanges}" SelectedItem="{Binding PlanRangeNm}" ToolTip="ASR range">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource RangeLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
